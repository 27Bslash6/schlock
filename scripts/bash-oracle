#!/usr/bin/env bash
# bash-oracle: run one command line in a real bash, inside a throwaway sandbox.
#
#   scripts/bash-oracle [-t SECONDS] [--] COMMAND
#
# Real bash is the only ground truth for how bash reads a line, so schlock work runs
# candidate commands through it. Those candidates are built to get past text filters,
# which is why a guard like `if "rm -rf" in cmd` in a probe script is no guard at all:
# `$'\u72'm -rf ~` walks straight through it. This script is the only sanctioned way
# to execute a corpus, test-vector or evasion string (see CLAUDE.md).
#
# The sandbox (bubblewrap, unprivileged):
#   - an allowlist of host paths, all read-only: /usr (plus the /bin, /lib, ... it
#     backs) and /etc. Nothing else of the host is visible: no /home, /mnt, /media,
#     /run, /srv, /opt, /var, /root.
#   - HOME is an empty tmpfs mounted at the caller's own $HOME path, so `~` and a
#     literal home path both resolve to it exactly as they would outside. /tmp is a
#     separate empty tmpfs. Both vanish when the command exits.
#   - every namespace unshared (no network), a new session (no TIOCSTI onto the
#     caller's terminal), no capabilities, a cleared environment, stdin from /dev/null.
#   - killed with the caller (--die-with-parent) and after a timeout (default 10s).
#
# Output: bash's stdout and stderr pass through unchanged, then one line on stderr:
#   bash-oracle: exit=N          bash ran and exited N (this script also exits N)
#   bash-oracle: timeout=S       killed after S seconds (exit 124; a command that
#                                itself exits 124 reports exit=124)
#   bash-oracle: sandbox-failed  nothing ran (exit 125)
# There is no unsandboxed fallback: without a working bwrap this script refuses to run.

set -euo pipefail

timeout_s=10
while (($#)); do
    case "$1" in
        -t)
            timeout_s="${2:?-t needs SECONDS}"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -h | --help)
            sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
            exit 0
            ;;
        *) break ;;
    esac
done
if (($# != 1)); then
    echo "usage: bash-oracle [-t SECONDS] [--] COMMAND" >&2
    exit 2
fi
if [[ ! "$timeout_s" =~ ^[1-9][0-9]*$ ]]; then
    echo "bash-oracle: -t must be a positive integer, got '$timeout_s'" >&2
    exit 2
fi

fail() {
    echo "bash-oracle: $1" >&2
    echo "bash-oracle: sandbox-failed" >&2
    exit 125
}

# HOME becomes a tmpfs mount point, so it must not shadow the paths bash runs from.
case "${HOME:-}" in
    / | /usr | /usr/* | /etc | /etc/* | /bin* | /sbin* | /lib* | /proc* | /dev*)
        fail "HOME=$HOME would hide system paths inside the sandbox"
        ;;
    /*) ;;
    *) fail "HOME must be an absolute path, got '${HOME:-}'" ;;
esac

command -v bwrap > /dev/null || fail "bwrap not found; refusing to run unsandboxed"

mounts=(--ro-bind /usr /usr --ro-bind /etc /etc)
for dir in /bin /sbin /lib /lib32 /lib64 /libx32; do
    if [[ -L "$dir" ]]; then
        mounts+=(--symlink "$(readlink "$dir")" "$dir")
    elif [[ -d "$dir" ]]; then
        mounts+=(--ro-bind "$dir" "$dir")
    fi
done

# The marker proves the sandbox was fully built before the command ran: bwrap reports
# its own setup failures as exit 1, which is indistinguishable from bash's exit 1.
marker="$(mktemp)"
trap 'rm -f "$marker"' EXIT

status=0
# shellcheck disable=SC2016 # $1 expands in the sandboxed bash, not here
timeout --kill-after=2 "$timeout_s" \
    bwrap \
    --unshare-all \
    --die-with-parent \
    --new-session \
    --cap-drop ALL \
    --clearenv \
    --setenv HOME "$HOME" \
    --setenv PATH /usr/local/bin:/usr/bin:/bin \
    --setenv LANG C.UTF-8 \
    "${mounts[@]}" \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --tmpfs "$HOME" \
    --chdir "$HOME" \
    --remount-ro / \
    /usr/bin/bash -c 'printf ok >&3 && exec 3>&- && exec bash -c "$1"' bash "$1" \
    3> "$marker" < /dev/null || status=$?

if [[ ! -s "$marker" ]]; then
    ((status == 124)) && fail "timed out before the sandbox started"
    fail "bwrap could not build the sandbox (status $status); nothing ran.
  bwrap needs unprivileged user namespaces. Ubuntu 23.10+ restricts them with AppArmor
  (kernel.apparmor_restrict_unprivileged_userns=1); see CONTRIBUTING.md for the profile."
fi
if ((status == 124)); then
    echo "bash-oracle: timeout=$timeout_s" >&2
    exit 124
fi
echo "bash-oracle: exit=$status" >&2
exit "$status"
